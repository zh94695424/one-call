{
  "id": "s1-07-missing-zero-partial",
  "stage": "s1",
  "description": "Missing values remain null and INCOMPLETE, explicit zero values are legal, partial metrics retain complete siblings, groups/root take the worst status, and independent groups still compute.",
  "cases": [
    {
      "id": "partial-media-group",
      "behavior": "Recording rate/duration/daily bytes are COMPLETE while retained bytes, derived objects, legal hold and backup stay INCOMPLETE; group is partial with worst status.",
      "input": {
        "meta": {"status": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "approvedBy": null, "approvedAt": null},
        "mediaIngestStorage": {
          "REC_BITRATE_BPS": {"value": 64000, "unit": "bitsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "REC_MEAN_VALIDATED_S": {"value": 60, "unit": "seconds", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "REC_PER_DAY": {"value": 100, "unit": "countPerDay", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"}
        }
      },
      "expect": {
        "metrics": {
          "mediaIngestStorage.recordingBitsPerSecond": {"status": "COMPLETE", "value": 64000, "unit": "bitsPerSecond"},
          "mediaIngestStorage.bytesPerRecording": {"status": "COMPLETE", "value": 480000, "unit": "bytes"},
          "mediaIngestStorage.dailyOriginalBytes": {"status": "COMPLETE", "value": 48000000, "unit": "bytesPerDay"},
          "mediaIngestStorage.retainedOriginalBytes": {"status": "INCOMPLETE", "valueNull": true},
          "mediaIngestStorage.derived.preview": {"status": "INCOMPLETE", "valueNull": true},
          "mediaIngestStorage.logicalMediaBytes": {"status": "INCOMPLETE", "valueNull": true},
          "mediaIngestStorage.backupMediaBytes": {"status": "INCOMPLETE", "valueNull": true}
        },
        "groups": {"mediaIngestStorage": {"status": "INCOMPLETE", "partial": true}},
        "noInvalidMetrics": true
      }
    },
    {
      "id": "missing-is-not-zero",
      "behavior": "A missing recording duration produces null bytes/recording, never a fabricated zero.",
      "input": {
        "meta": {"status": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "approvedBy": null, "approvedAt": null},
        "mediaIngestStorage": {
          "REC_BITRATE_BPS": {"value": 64000, "unit": "bitsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "REC_PER_DAY": {"value": 100, "unit": "countPerDay", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"}
        }
      },
      "expect": {
        "metrics": {
          "mediaIngestStorage.bytesPerRecording": {"status": "INCOMPLETE", "valueNull": true, "missingInclude": ["mediaIngestStorage.REC_MEAN_VALIDATED_S"]},
          "mediaIngestStorage.dailyOriginalBytes": {"status": "INCOMPLETE", "valueNull": true}
        }
      }
    },
    {
      "id": "explicit-zero-legal",
      "behavior": "Explicit zero playback concurrency and daily sessions produce legal zero metrics, not INCOMPLETE.",
      "input": {
        "meta": {"status": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "approvedBy": null, "approvedAt": null},
        "playback": {
          "PB_CONCURRENT_SESSIONS": {"value": 0, "unit": "count", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "PB_BITRATE_BPS": {"value": 500000, "unit": "bitsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "PB_SESSIONS_PER_DAY": {"value": 0, "unit": "countPerDay", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "PB_MEAN_SECONDS": {"value": 60, "unit": "seconds", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "PB_CDN_CACHE_HIT_RATIO": {"value": 0.5, "unit": "ratio", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"}
        }
      },
      "expect": {
        "metrics": {
          "playback.peakBitsPerSecond": {"status": "COMPLETE", "value": 0, "unit": "bitsPerSecond", "limitationsInclude": ["ZERO_FACTOR_SHORT_CIRCUIT"]},
          "playback.dailyPayloadBytes": {"status": "COMPLETE", "value": 0, "unit": "bytesPerDay"},
          "playback.originBytesPerDay": {"status": "COMPLETE", "value": 0, "unit": "bytesPerDay"}
        },
        "errorsEmpty": true
      }
    },
    {
      "id": "independent-group-still-computes",
      "behavior": "A missing IVR group is INCOMPLETE while playback still computes; root takes the worst group status.",
      "input": {
        "meta": {"status": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "approvedBy": null, "approvedAt": null},
        "playback": {
          "PB_CONCURRENT_SESSIONS": {"value": 2, "unit": "count", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "PB_BITRATE_BPS": {"value": 1000, "unit": "bitsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"}
        }
      },
      "expect": {
        "root": {"status": "INCOMPLETE"},
        "metrics": {
          "playback.peakBitsPerSecond": {"status": "COMPLETE", "value": 2000, "unit": "bitsPerSecond"},
          "ivrLines.a": {"status": "INCOMPLETE", "valueNull": true}
        },
        "groups": {"ivrLines": {"status": "INCOMPLETE"}, "playback": {"status": "INCOMPLETE", "partial": true}}
      }
    },
    {
      "id": "malformed-beside-zero-factor",
      "behavior": "A negative duration beside a zero rate still makes the metric INVALID; the zero-factor shortcut never swallows malformed values.",
      "input": {
        "meta": {"status": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "approvedBy": null, "approvedAt": null},
        "ivrLines": {
          "IVR_IN_RATE_PS": {"value": 0, "unit": "callsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "IVR_IN_HOLD_S": {"value": -1, "unit": "seconds", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-07", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"}
        }
      },
      "expect": {
        "root": {"status": "INVALID"},
        "metrics": {"ivrLines.a": {"status": "INVALID", "valueNull": true, "reasonsInclude": ["NEGATIVE_VALUE"]}},
        "errorsInclude": [{"code": "NEGATIVE_VALUE", "path": "ivrLines.IVR_IN_HOLD_S"}]
      }
    }
  ]
}
