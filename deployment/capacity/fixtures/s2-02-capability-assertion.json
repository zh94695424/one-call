        "flagsInclude": ["DEPLOYMENT_EVIDENCE_INCOMPLETE", "NO_CLOUD_VERIFICATION", "A3_RISK_NOT_CLOSED"],
        "errorsEmpty": true,
        "noInvalidMetrics": true
