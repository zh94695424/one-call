{
  "id": "s1-06-node-api",
  "stage": "s1",
  "description": "API control-plane totals/in-flight estimates and measured node roles: stateless per-node arithmetic with N-1, stateful degraded topology, shared media-gateway capacity, resource evidence and role verdicts.",
  "cases": [
    {
      "id": "api-total-and-in-flight",
      "behavior": "Five API classes sum to total requests/s; in-flight uses mean service; DB transaction in-flight is an estimate with TXN_PER_REQUEST_NOT_MEASURED.",
      "input": {
        "meta": {"status": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "approvedBy": null, "approvedAt": null},
        "apiControlPlane": {
          "API_RATE_PS": {
            "customer": {"value": 0.1, "unit": "requestsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
            "operations": {"value": 0.2, "unit": "requestsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
            "ivrControl": {"value": 0.3, "unit": "requestsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
            "publicShare": {"value": 0.4, "unit": "requestsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
            "providerCallback": {"value": 0.5, "unit": "requestsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"}
          },
          "API_MEAN_SERVICE_S": {"value": 2, "unit": "seconds", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "API_DB_TXN_MEAN_S": {"value": 0.5, "unit": "seconds", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"}
        }
      },
      "expect": {
        "metrics": {
          "apiControlPlane.totalRate": {"status": "COMPLETE", "value": 1.5, "unit": "requestsPerSecond"},
          "apiControlPlane.inFlight": {"status": "COMPLETE", "value": 3, "unit": "requests"},
          "apiControlPlane.dbTxnInFlightEstimate": {"status": "COMPLETE", "value": 0.75, "unit": "transactions", "limitationsInclude": ["TXN_PER_REQUEST_NOT_MEASURED"]}
        },
        "groups": {"apiControlPlane": {"status": "COMPLETE"}},
        "errorsEmpty": true
      }
    },
    {
      "id": "stateless-required-and-nminus-one",
      "behavior": "requiredNodes=ceil(demand/(perNodeRate x (1-headroom))); N-1 uses the same headroom; synthetic evidence is ARITHMETIC_ONLY, not FIT_EVIDENCE_COMPLETE.",
      "input": {
        "meta": {"status": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "approvedBy": null, "approvedAt": null},
        "measuredNodes": {
          "MEASURED_ROLE": [
            {
              "role": "core-api",
              "demandUnit": "requestsPerSecond",
              "demandQuantity": {"value": 10, "unit": "requestsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
              "perNodeRate": {"value": 20, "unit": "requestsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
              "deployedNodes": {"value": 3, "unit": "nodes", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
              "headroomRatio": {"value": 0.1, "unit": "ratio", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
              "measuredCpuUtilization": {"value": 0.2, "unit": "ratio", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
              "measuredRamUtilization": {"value": 0.2, "unit": "ratio", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
              "measuredConnectionsUtilization": {"value": 0.2, "unit": "ratio", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
              "measuredIopsUtilization": {"value": 0.2, "unit": "ratio", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
              "resourceEvidenceRef": "s1-06-evidence",
              "measuredAt": {"value": "2026-10-20T00:00:00Z", "unit": "iso8601", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-06", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"}
            }
          ]
        }
      },
      "expect": {
        "metrics": {
          "measuredNodes.core-api.requiredNodes": {"status": "COMPLETE", "value": 1, "unit": "nodes"},
          "measuredNodes.core-api.nMinusOne": {"status": "COMPLETE", "value": true, "unit": "boolean"},
          "measuredNodes.core-api.resourceEvidence": {"status": "COMPLETE", "value": true, "unit": "boolean"},
          "measuredNodes.core-api": {"status": "NOT_VERIFIED", "value": "ARITHMETIC_ONLY"}
        },
        "errorsEmpty": true,
        "noInvalidMetrics": true
      }
    },
