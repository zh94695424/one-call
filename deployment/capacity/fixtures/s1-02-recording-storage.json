        "meta": {"status": "SYNTHETIC_TEST_ONLY", "source": "s1-02", "approvedBy": null, "approvedAt": null},
        "mediaIngestStorage": {
          "REC_BITRATE_BPS": {"value": 64000, "unit": "bitsPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-02", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "REC_MEAN_VALIDATED_S": {"value": 60, "unit": "seconds", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-02", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "REC_PER_DAY": {"value": 10, "unit": "countPerDay", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-02", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "REC_RETENTION_DAYS": {"value": 30, "unit": "days", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-02", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
          "REC_ORIGINAL_VERSION_FACTOR": {"value": 0.5, "unit": "ratio", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-02", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"}
