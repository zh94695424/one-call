      "expect": {
        "root": {"status": "INVALID"},
        "metrics": {
          "mediaIngestStorage.derivedDaily.preview": {"status": "INVALID", "reasonsInclude": ["PROVENANCE_INVALID"]},
          "mediaIngestStorage.derived.preview": {"status": "INVALID"}
        },
        "errorsInclude": [{"code": "PROVENANCE_INVALID", "path": "mediaIngestStorage.REC_DERIVED_BY_TYPE.preview.bytesPerOriginalByte"}]
      }
    },
    {
      "id": "version-factor-below-one-invalid",
      "behavior": "REC_ORIGINAL_VERSION_FACTOR=0.5 is RATIO_OUT_OF_RANGE, distinct from legal 1.2.",
