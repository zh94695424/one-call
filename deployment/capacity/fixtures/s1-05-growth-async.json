          "QUEUE_SERVICE_TASKS_PS": {"value": 12, "unit": "tasksPerSecond", "provenance": "SYNTHETIC_TEST_ONLY", "source": "s1-05", "owner": "synthetic", "approval": "SYNTHETIC_TEST_ONLY"},
