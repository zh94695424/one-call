{
  "schemaVersion": 1,
  "id": "sec-s3-06-redaction-deterministic",
  "slice": "s3",
  "negative": false,
  "description": "Redaction applies an allow-list, a recursive deny-list at any depth, credential/header/path pattern controls and destination policy before emit; tokens are deterministic, only recognized display-safe masked variants survive, masked keys cannot bypass pattern controls, unknown fields block, and support cannot request playback.",
  "materials": [],
  "steps": [
    {
      "id": "log-recursive-nested",
      "action": "redact",
      "destination": "log",
      "event": {
        "id": "TEST_ONLY_EVENT_0001",
        "status": "ACTIVE",
        "context": {
          "phone": "TEST_ONLY_PHONE_0001",
          "calleeNumberMasked": "138****0000",
          "providerSubject": "TEST_ONLY_PROVIDER_SUBJECT",
          "request": {
            "nonce": "TEST_ONLY_NONCE_0001",
            "method": "POST"
          }
        },
        "path": "/api/v1/public/shares/TEST_ONLY_CAPABILITY_0001/view"
      },
      "expected": {
        "status": "OK",
        "destination": "log",
        "statusCode": null,
        "problemCode": null,
        "reason": "EMITTED_REDACTED",
        "emitted": true,
        "blocked": false,
        "alert": false,
        "redactedEvent": {
          "id": "TEST_ONLY_EVENT_0001",
          "status": "ACTIVE",
          "context": {
            "phone": "[REDACTED:PHONE]",
            "calleeNumberMasked": "138****0000",
            "providerSubject": "[REDACTED:PROVIDER_SUBJECT]",
            "request": {
              "nonce": "[REDACTED:NONCE]",
              "method": "POST"
            }
          },
          "path": "/api/v1/public/shares/[REDACTED:CAPABILITY_TOKEN]/view"
        },
        "tokens": ["[REDACTED:CAPABILITY_TOKEN]", "[REDACTED:NONCE]", "[REDACTED:PHONE]", "[REDACTED:PROVIDER_SUBJECT]"],
        "tokenCount": 4,
        "deterministic": true,
        "redactionAppliedBeforeEmit": true,
        "rawExposed": false
      }
    },
    {
      "id": "log-credential-and-headers",
      "action": "redact",
      "destination": "log",
      "event": {
        "id": "TEST_ONLY_EVENT_0002",
        "status": "OK",
        "context": {
          "headers": {
            "authorization": "Bearer TEST_ONLY_BEARER",
            "cookie": "TEST_ONLY_COOKIE",
            "signature": "TEST_ONLY_SIGNATURE"
          },
          "credential": "TEST_ONLY_CREDENTIAL_VALUE"
