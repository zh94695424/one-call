      "keyRef": "TEST_ONLY_K18_V1",
      "profileAvailable": true,
      "signatureMode": "valid",
      "timestamp": "1700000000",
      "receivedAt": 1700000000,
      "windowSeconds": 300,
      "nonce": "TEST_ONLY_PROVIDER_NONCE_0602",
      "nonceStore": "AVAILABLE",
      "eventId": "TEST_ONLY_PROVIDER_EVENT_0001",
      "payloadFingerprint": "TEST_ONLY_PROVIDER_PAYLOAD_0001",
      "expected": {
        "status": "OK",
        "statusCode": 200,
        "problemCode": null,
        "reason": "ACCEPTED",
        "accepted": true,
        "duplicate": false,
        "nonceConsumed": true,
        "paymentsCreated": 1,
        "entitlementsCreated": 1,
        "payments": 1,
        "entitlements": 1,
        "providerEvents": 1
      }
    },
    {
      "id": "nonce-replay",
      "action": "provider-callback",
      "mtls": { "present": true, "serviceIdentity": "provider", "certificateState": "ACTIVE" },
      "keyRef": "TEST_ONLY_K18_V1",
      "profileAvailable": true,
      "signatureMode": "valid",
      "timestamp": "1700000100",
      "receivedAt": 1700000100,
      "windowSeconds": 300,
      "nonce": "TEST_ONLY_PROVIDER_NONCE_0602",
      "nonceStore": "AVAILABLE",
      "eventId": "TEST_ONLY_PROVIDER_EVENT_0002",
      "payloadFingerprint": "TEST_ONLY_PROVIDER_PAYLOAD_0002",
      "expected": {
        "status": "DENIED",
        "statusCode": 401,
        "problemCode": "CALLBACK_SIGNATURE_INVALID",
        "reason": "NONCE_REPLAY",
        "nonceConsumed": false,
        "paymentsCreated": 0,
        "payments": 1,
        "entitlements": 1
      }
    },
    {
      "id": "exact-duplicate",
      "action": "provider-callback",
      "mtls": { "present": true, "serviceIdentity": "provider", "certificateState": "ACTIVE" },
      "keyRef": "TEST_ONLY_K18_V1",
      "profileAvailable": true,
