        "statusCode": 200,
        "problemCode": null,
        "reason": "EXACT_DUPLICATE",
        "accepted": true,
        "duplicate": true,
        "nonceConsumed": false,
        "paymentsCreated": 0,
        "entitlementsCreated": 0,
        "payments": 1,
        "entitlements": 1
      }
    },
    {
      "id": "changed-payload-conflict",
