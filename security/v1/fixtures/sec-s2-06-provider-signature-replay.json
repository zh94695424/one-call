{
  "schemaVersion": 1,
  "id": "sec-s2-06-provider-signature-replay",
  "slice": "s2",
  "negative": true,
  "description": "Provider callbacks reject a bad signature and a replayed nonce, return an exact-duplicate 200 without requiring nonce consumption, and return 409 for a changed payload only after the nonce check, with no duplicate payment or entitlement.",
  "materials": [
    { "keyId": "K18", "keyRef": "TEST_ONLY_K18_V1", "keyLabel": "TEST_ONLY_K18_VERIFY_V1", "state": "ACTIVE" }
  ],
  "steps": [
    {
      "id": "bad-signature",
      "action": "provider-callback",
      "mtls": { "present": true, "serviceIdentity": "provider", "certificateState": "ACTIVE" },
      "keyRef": "TEST_ONLY_K18_V1",
      "profileAvailable": true,
      "signatureMode": "invalid",
      "timestamp": "1700000000",
      "receivedAt": 1700000000,
      "windowSeconds": 300,
      "nonce": "TEST_ONLY_PROVIDER_NONCE_0601",
      "nonceStore": "AVAILABLE",
      "eventId": "TEST_ONLY_PROVIDER_EVENT_0001",
      "payloadFingerprint": "TEST_ONLY_PROVIDER_PAYLOAD_0001",
      "expected": {
        "status": "DENIED",
        "statusCode": 401,
        "problemCode": "CALLBACK_SIGNATURE_INVALID",
        "reason": "SIGNATURE_INVALID",
        "duplicate": false,
        "accepted": false,
        "paymentsCreated": 0,
        "entitlementsCreated": 0,
        "payments": 0,
        "entitlements": 0
      }
    },
    {
      "id": "new-event-accepted",
      "action": "provider-callback",
