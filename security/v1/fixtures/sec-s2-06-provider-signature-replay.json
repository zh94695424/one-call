      "eventId": "TEST_ONLY_PROVIDER_EVENT_0001",
      "payloadFingerprint": "TEST_ONLY_PROVIDER_PAYLOAD_CHANGED",
      "expected": {
        "status": "DENIED",
        "statusCode": 401,
