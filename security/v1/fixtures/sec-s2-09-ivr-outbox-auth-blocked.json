{
  "schemaVersion": 1,
  "id": "sec-s2-09-ivr-outbox-auth-blocked",
  "slice": "s2",
  "negative": true,
  "description": "An IVR-local outbox keeps the same PENDING entry security-blocked after 401 and 403, rejects hot retry, identity or payload mutation, redial, re-resolve, reservation and settlement, emits only redacted alerts, and retries only after an explicit recovery signal with the same non-empty domain identity and fresh, well-formed transport values that have not been reused.",
  "materials": [],
  "steps": [
    {
      "id": "observe-401",
      "action": "ivr-outbox",
      "eventId": "TEST_ONLY_OUTBOX_EVENT_401",
      "payloadFingerprint": "TEST_ONLY_OUTBOX_PAYLOAD_401",
      "domainIdentity": { "callId": "TEST_ONLY_CALL_401", "eventId": "TEST_ONLY_OUTBOX_EVENT_401" },
      "observedStatus": 401,
      "transportNonce": "TEST_ONLY_OUTBOX_NONCE_0901",
      "transportTimestamp": "1700000000",
      "expected": {
        "status": "DENIED",
        "statusCode": 401,
        "problemCode": "UNAUTHENTICATED",
        "reason": "OBSERVED_UNAUTHENTICATED",
        "outboxState": "PENDING",
        "eventId": "TEST_ONLY_OUTBOX_EVENT_401",
        "sameEventId": true,
        "samePayload": true,
        "securityBlocked": true,
        "retried": false,
        "alertSignal": "IVR_OUTBOX_SECURITY_BLOCKED",
        "alertRedacted": true,
        "credentialExposed": false,
        "signatureLogged": false,
        "nonceLogged": false,
        "sideEffects": { "sessions": 0, "calls": 0, "decisions": 0, "tasks": 0, "reservations": 0, "settlements": 0, "events": 0, "redials": 0, "reResolves": 0 }
      }
    },
