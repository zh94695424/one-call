      "action": "ivr-request",
      "mtls": { "present": true, "serviceIdentity": "ivr-gateway", "certificateState": "ACTIVE" },
      "method": "POST",
      "path": "/api/v1/ivr/calls/TEST_ONLY_CALL_0001/events",
      "body": "TEST_ONLY_IVR_EVENT_BODY_0001",
      "keyRef": "TEST_ONLY_K17_V1",
      "timestamp": "1700000000",
      "receivedAt": 1700000100,
      "windowSeconds": 300,
      "nonce": "TEST_ONLY_NONCE_0501",
      "nonceStore": "AVAILABLE",
      "a2": { "eventId": "TEST_ONLY_EVENT_0001", "payloadFingerprint": "TEST_ONLY_PAYLOAD_0001", "callId": "TEST_ONLY_CALL_0001" },
      "expected": {
        "status": "DENIED",
        "statusCode": 401,
        "problemCode": "UNAUTHENTICATED",
        "reason": "NONCE_REPLAY",
