{
  "schemaVersion": 1,
  "id": "sec-s2-05-ivr-replay-rejected",
  "slice": "s2",
  "negative": true,
  "description": "A replayed transport nonce and an unavailable Redis nonce store are rejected before A2 processing; after recovery the same eventId and payload with a fresh timestamp and nonce return the A2 first result without redial or a second reservation.",
  "materials": [
    { "keyId": "K17", "keyRef": "TEST_ONLY_K17_V1", "keyLabel": "TEST_ONLY_K17_SIGNING_V1", "state": "ACTIVE" }
