      "plaintext": "TEST_ONLY_SHARED_VALUE_0001",
      "expected": { "status": "OK", "hmacPattern": true, "hmacLength": 64, "scanMode": "INDEXED_EQUALITY", "plaintextScanned": false, "keyState": "ACTIVE" }
    },
