{
  "schemaVersion": 1,
  "id": "sec-s3-07-credential-url-leak",
  "slice": "s3",
  "negative": true,
  "description": "Credential-bearing paths, upload/playback credentials, signature/nonce, Authorization/Cookie and provider details never reach logs, traces, errors, analytics, support or public contracts; support and analytics cannot request playback, and support exposes only recognized display-safe masked fields.",
  "materials": [],
  "steps": [
    {
      "id": "log-secret-egress-redacted",
      "action": "redact",
      "destination": "log",
      "event": {
        "id": "TEST_ONLY_EVENT_0701",
        "status": "OK",
        "path": "/api/v1/public/shares/TEST_ONLY_CAPABILITY_0701/view",
        "context": {
          "headers": {
            "authorization": "Bearer TEST_ONLY_BEARER_0701",
            "cookie": "TEST_ONLY_COOKIE_0701"
          },
          "uploadCredential": "TEST_ONLY_UPLOAD_CREDENTIAL_0701",
          "playbackCredential": "TEST_ONLY_PLAYBACK_CREDENTIAL_0701",
          "signature": "TEST_ONLY_SIGNATURE_0701",
          "nonce": "TEST_ONLY_NONCE_0701"
        }
      },
      "expected": {
        "status": "OK",
        "destination": "log",
        "reason": "EMITTED_REDACTED",
        "emitted": true,
        "rawExposed": false,
        "redactedEvent": {
          "id": "TEST_ONLY_EVENT_0701",
          "status": "OK",
          "path": "/api/v1/public/shares/[REDACTED:CAPABILITY_TOKEN]/view",
          "context": {
            "headers": {
              "authorization": "[REDACTED:AUTHORIZATION]",
              "cookie": "[REDACTED:COOKIE]"
            },
            "uploadCredential": "[REDACTED:CREDENTIAL]",
            "playbackCredential": "[REDACTED:CREDENTIAL]",
            "signature": "[REDACTED:SIGNATURE]",
            "nonce": "[REDACTED:NONCE]"
          }
        },
        "tokens": ["[REDACTED:AUTHORIZATION]", "[REDACTED:CAPABILITY_TOKEN]", "[REDACTED:COOKIE]", "[REDACTED:CREDENTIAL]", "[REDACTED:NONCE]", "[REDACTED:SIGNATURE]"],
        "tokenCount": 6,
        "deterministic": true
      }
    },
    {
      "id": "trace-token-and-hmac-redacted",
      "action": "redact",
      "destination": "trace",
      "event": {
        "id": "TEST_ONLY_EVENT_0702",
        "status": "OK",
        "count": 2,
        "context": {
          "capabilityToken": "TEST_ONLY_CAPABILITY_0702",
          "hmac": "TEST_ONLY_HMAC_0702"
        }
      },
      "expected": {
        "status": "OK",
        "destination": "trace",
        "reason": "EMITTED_REDACTED",
        "emitted": true,
        "rawExposed": false,
        "redactedEvent": {
          "id": "TEST_ONLY_EVENT_0702",
          "status": "OK",
          "count": 2,
          "context": {
            "capabilityToken": "[REDACTED:CAPABILITY_TOKEN]",
            "hmac": "[REDACTED:HMAC]"
          }
        },
        "tokens": ["[REDACTED:CAPABILITY_TOKEN]", "[REDACTED:HMAC]"],
        "tokenCount": 2,
        "deterministic": true
      }
    },
    {
      "id": "error-provider-detail-blocked",
      "action": "redact",
      "destination": "error",
      "event": {
        "status": "ERROR",
        "reasonCode": "TEST_ONLY_REASON",
        "traceId": "TEST_ONLY_TRACE",
        "providerMessage": "TEST_ONLY_PROVIDER_DETAIL"
      },
      "expected": {
        "status": "DENIED",
        "destination": "error",
        "statusCode": 500,
        "problemCode": "INTERNAL",
        "reason": "SECURITY_REDACTION_BLOCKED",
        "emitted": false,
        "blocked": true,
        "alert": true,
        "blockedField": "providerMessage",
        "rawExposed": false
      }
    },
    {
      "id": "analytics-playback-denied",
      "action": "redact",
      "destination": "analytics",
      "playbackRequested": true,
      "event": {
        "id": "TEST_ONLY_EVENT_0704",
        "status": "OK",
        "count": 1
      },
      "expected": {
        "status": "DENIED",
        "destination": "analytics",
        "statusCode": 403,
        "problemCode": "FORBIDDEN",
        "reason": "PLAYBACK_NOT_ALLOWED",
        "emitted": false,
        "playbackAllowed": false,
        "playbackDenied": true,
        "rawExposed": false
      }
    },
    {
      "id": "support-playback-and-secret-fields-denied",
      "action": "support-view",
      "requestedFields": ["id", "status", "calleeNumberMasked", "objectKey", "playbackCredential", "providerSubject"],
      "playbackRequested": true,
      "expected": {
        "status": "DENIED",
        "statusCode": 403,
        "problemCode": "FORBIDDEN",
        "reason": "PLAYBACK_NOT_ALLOWED",
        "allowedFields": ["id", "status", "calleeNumberMasked"],
        "deniedFields": ["objectKey", "playbackCredential", "providerSubject"],
        "playbackAllowed": false,
        "playbackDenied": true,
        "rawSensitiveExposed": false,
        "credentialExposed": false,
        "objectKeyExposed": false,
        "cosUrlExposed": false,
        "supportAllowList": ["id", "internalId", "status", "reasonCode", "masked fields"]
      }
    },
    {
      "id": "public-contract-masked-only",
      "action": "redact",
      "destination": "public-contract",
      "event": {
        "id": "TEST_ONLY_EVENT_0706",
        "status": "ACTIVE",
        "calleeNumberMasked": "138****0000",
        "capabilityToken": "TEST_ONLY_CAPABILITY_0706"
      },
      "expected": {
        "status": "OK",
        "destination": "public-contract",
        "reason": "EMITTED_REDACTED",
        "emitted": true,
        "rawExposed": false,
        "redactedEvent": {
          "id": "TEST_ONLY_EVENT_0706",
          "status": "ACTIVE",
          "calleeNumberMasked": "138****0000",
          "capabilityToken": "[REDACTED:CAPABILITY_TOKEN]"
        },
        "tokens": ["[REDACTED:CAPABILITY_TOKEN]"],
        "tokenCount": 1
      }
    },
    {
      "id": "support-no-playback-fields",
      "action": "support-view",
      "requestedFields": ["id", "status", "providerSubject"],
      "expected": {
        "status": "OK",
        "statusCode": 200,
        "problemCode": null,
        "reason": "SUPPORT_VIEW_REDACTED",
        "allowedFields": ["id", "status"],
        "deniedFields": ["providerSubject"],
        "playbackAllowed": false,
        "playbackDenied": false,
        "rawSensitiveExposed": false,
        "credentialExposed": false,
        "objectKeyExposed": false,
        "cosUrlExposed": false
      }
    },
    {
      "id": "support-view-credential-masked-denied",
      "action": "support-view",
      "requestedFields": ["id", "calleeNumberMasked", "credentialMasked", "capabilityTokenMasked", "randomMasked"],
      "expected": {
        "status": "OK",
        "statusCode": 200,
        "problemCode": null,
        "reason": "SUPPORT_VIEW_REDACTED",
        "allowedFields": ["id", "calleeNumberMasked"],
        "deniedFields": ["credentialMasked", "capabilityTokenMasked", "randomMasked"],
        "playbackAllowed": false,
        "playbackDenied": false,
        "rawSensitiveExposed": false,
        "credentialExposed": false,
        "objectKeyExposed": false,
        "cosUrlExposed": false
      }
    },
    {
      "id": "assert-no-leak",
      "action": "assert",
      "checks": {
        "redactionTokens": 28,
        "redactionEmits": 3,
        "redactionBlocks": 1,
        "invariants": 21,
        "auditEvents": 39
      },
      "expected": { "status": "OK", "mismatches": [] }
    }
  ]
}
