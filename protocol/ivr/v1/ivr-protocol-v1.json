  "invariants": [
    {
      "id": "INV-A2-01",
      "text": "One callId maps to one inbound session/call; a second callId is never minted for the same inbound call."
    },
    {
      "id": "INV-A2-02",
      "text": "One decision has exactly one executable intent; the IVR never recomputes routing or selects another callee."
    },
    {
      "id": "INV-A2-03",
      "text": "One call has at most one B-leg operation and one actual line request; unknown outcomes or restarts never cause a second dial."
    },
    {
      "id": "INV-A2-04",
      "text": "One call has at most one reservation, one terminal settlement or release, and one usage fact."
    },
    {
      "id": "INV-A2-05",
      "text": "The first accepted terminal fact is absorbed; terminal facts never regress; UNKNOWN converges only through reconciliation."
    },
    {
      "id": "INV-A2-06",
      "text": "The (callId,purpose) decision is immutable; activation confirmation never rewrites the resolve decision."
    },
    {
      "id": "INV-A2-07",
      "text": "The single-caller single-nonterminal-task rule and reciprocal task/call links remain A0 invariants."
    },
    {
      "id": "INV-A2-08",
      "text": "Event identity is immutable; the same identity and fingerprint returns the first outcome, while changed content conflicts or quarantines."
    },
    {
      "id": "INV-A2-09",
      "text": "Recording identity is immutable; declared facts never overwrite server-observed facts; completion never solidifies evidence."
    },
    {
      "id": "INV-A2-10",
      "text": "The task path never asks for callee confirmation; the direct path never claims a task; there is no latest-callee fallback."
    },
    {
      "id": "INV-A2-11",
      "text": "Heartbeat never changes business state, never releases a reservation, never authorizes a call and never triggers redial."
    },
    {
      "id": "INV-A2-12",
      "text": "No protocol output, log, audit or outbox exposes a plaintext callee or an object key, URL or credential."
    },
    {
      "id": "INV-A2-13",
      "text": "The protocol version is frozen at resolve; an unsupported version fails before side effects; a call never upgrades mid-call."
    },
    {
      "id": "INV-A2-14",
      "text": "Every unknown outcome fails closed without redial, double reservation, double settlement or contradictory facts."
    },
    {
      "id": "INV-A2-15",
      "text": "Declaration and completion retries reuse recordingId and never create a second recording or media object."
    }
  ]
