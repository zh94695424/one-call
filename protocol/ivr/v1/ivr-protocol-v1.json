    "conditions": [
      {
        "condition": "A1 closed schema type or length failure",
        "operations": "all",
        "http": 422,
        "code": "VALIDATION_FAILED",
        "retryable": false,
        "sideEffect": "none"
      },
      {
        "condition": "version malformed or unsupported, unknown eventType, or A2 payload or leg rule violation",
        "operations": "all",
        "http": 400,
        "code": "IVR_ARGUMENT_INVALID",
        "retryable": false,
        "sideEffect": "no session, call or event write"
      },
      {
        "condition": "decision, session, access-number or fingerprint conflict",
        "operations": "resolveIvrInbound,confirmIvrActivation,authorizeIvrDirectOutbound",
        "http": 409,
        "code": "SESSION_IDENTITY_MISMATCH",
        "retryable": false,
        "sideEffect": "none"
      },
      {
        "condition": "confirm or direct request for an unknown call",
        "operations": "confirmIvrActivation,authorizeIvrDirectOutbound",
        "http": 409,
        "code": "SESSION_IDENTITY_MISMATCH",
        "retryable": false,
        "sideEffect": "none; A1 declares no CALL_UNKNOWN for these operations"
      },
      {
        "condition": "event identity or semantic conflict",
        "operations": "ingestIvrCallEvent",
        "http": 409,
        "code": "EVENT_ID_CONFLICT",
        "retryable": false,
        "sideEffect": "first outcome unchanged"
      },
      {
        "condition": "missing parent call for an event, declaration or completion",
        "operations": "ingestIvrCallEvent,declareIvrRecording,completeIvrRecording",
        "http": 404,
        "code": "CALL_UNKNOWN",
        "retryable": false,
        "sideEffect": "no placeholder"
      },
      {
        "condition": "recording identity or declaration conflict",
        "operations": "declareIvrRecording,completeIvrRecording",
        "http": 409,
        "code": "RECORDING_IDENTITY_CONFLICT",
        "retryable": false,
        "sideEffect": "no overwrite"
      },
      {
        "condition": "completion before server upload observation",
        "operations": "completeIvrRecording",
        "http": 409,
        "code": "UPLOAD_OBSERVATION_REQUIRED",
        "retryable": true,
        "sideEffect": "none; retry with the same recordingId"
      },
      {
        "condition": "upload expiry reached",
        "operations": "completeIvrRecording",
        "http": 409,
        "code": "UPLOAD_EXPIRED",
        "retryable": false,
        "sideEffect": "recording quarantine; no media fact"
      },
      {
        "condition": "storage or media outcome unknown",
        "operations": "completeIvrRecording",
        "http": 503,
        "code": "STORAGE_UNKNOWN",
        "retryable": true,
        "sideEffect": "no media fact; retry with the same recordingId"
      },
      {
        "condition": "rate limit, dependency or internal failure",
        "operations": "all",
        "http": "429|503|500",
        "code": "RATE_LIMITED|SERVICE_UNAVAILABLE|INTERNAL",
        "retryable": "conditional",
        "sideEffect": "none or rollback"
      },
      {
        "condition": "normal business refusal",
        "operations": "resolveIvrInbound,confirmIvrActivation,authorizeIvrDirectOutbound",
        "http": 200,
        "code": "IvrDecision",
        "retryable": false,
        "sideEffect": "exactly the frozen decision"
      },
      {
        "condition": "event fact contradiction, ordering or unknown leg",
        "operations": "ingestIvrCallEvent",
        "http": 200,
        "code": "CallEventReceipt QUARANTINED",
        "retryable": false,
        "sideEffect": "the fact is not applied"
      }
    ]
  },
  "preconditions": {
    "protocolVersion": {
      "literal": "1.0",
      "grammar": "^[0-9]+\\.[0-9]+$",
      "lengthMin": 1,
      "lengthMax": 32,
      "transport": "resolve request body only",
      "freezeAt": "resolve success",
      "unknownVersion": "400 IVR_ARGUMENT_INVALID before any session, call, task or reservation write",
      "minorCompatibility": "new optional fields or event types only; a new session is required; no mid-call upgrade",
      "majorCompatibility": "new session required; in-flight v1 continues under v1 or fails closed with 503 SERVICE_UNAVAILABLE",
      "downgrade": false
    },
    "decisionPaths": [
      {
        "id": "task-claim",
        "action": "DIAL_TASK_CALLEE",
        "requires": [
          "task status is PENDING",
          "expires_at is greater than database time at the conditional claim",
          "current caller, subject, binding, workspace and access checks pass",
          "conditional update changes the task from PENDING to CLAIMED",
          "one reservation HELD and one frozen decision commit in the same transaction"
        ],
        "forbidden": [
          "claiming without a reservation",
          "claiming on the direct path",
          "switching to another task"
        ]
      },
      {
        "id": "session-confirm",
        "action": "GUIDE_ACTIVATION",
        "requires": [
          "prior INBOUND_RESOLVE decision is GUIDE_ACTIVATION",
          "session status is RECEIVED",
          "explicit key 1 confirmation",
          "current policy, prompt and consent content",
          "confirmed subject matches the captured subject",
          "at most one first trial per subject",
          "no login account or real-name record creation"
        ],
        "forbidden": [
          "confirming without key 1",
          "granting a second trial",
          "rewriting the resolve decision"
        ]
      },
      {
        "id": "decision-freeze",
        "requires": [
          "one decision per (callId,purpose)",
          "a canonical purpose fingerprint",
          "first frozen decision returned on replay",
          "changed fingerprint returns 409 SESSION_IDENTITY_MISMATCH"
        ],
        "forbidden": [
          "overwriting a frozen decision",
          "recomputing state on replay",
          "creating a second decision for the same purpose"
        ]
      },
      {
        "id": "reservation-held",
        "requires": [
          "one reservation per call",
          "status HELD at creation",
          "authorizedRecordingSeconds copied from committed authorized_units",
          "authorizationExpiresAt copied and never renewed"
        ],
        "forbidden": [
          "creating a second reservation",
          "extending authorization on replay",
          "treating availableRecordingSeconds as spend authorization"
        ]
      },
      {
        "id": "direct-authorization",
        "action": null,
        "requires": [
          "prior ENTER_CALLEE decision on the same call",
          "taskMatch NONE",
          "task fields null",
          "one reservation HELD",
          "server-normalized DTMF callee",
          "success shape is action null with reasonCode DIRECT_AUTHORIZED"
        ],
        "forbidden": [
          "claiming a task",
          "using task fields",
          "authorizing a second direct outbound",
          "recollecting the callee"
        ]
      }
    ],
    "stateTransitions": [
      {
        "aggregate": "outbound_call_task",
        "from": "PENDING",
        "to": "CLAIMED",
        "trigger": "task-backed decision",
        "guard": "atomic claim with reservation and frozen decision"
      },
      {
        "aggregate": "inbound_session",
        "from": "RECEIVED",
        "to": "CONFIRMED",
        "trigger": "successful key 1 activation confirmation",
        "guard": "prior GUIDE_ACTIVATION resolve; current consent and prompt"
      },
      {
        "aggregate": "usage_reservation",
        "from": null,
        "to": "HELD",
        "trigger": "task-backed or direct authorization success",
        "guard": "one reservation per call"
      },
      {
        "aggregate": "ivr_decision",
        "from": null,
        "to": "frozen",
        "trigger": "resolve, activation confirmation or direct authorization",
        "guard": "unique (callId,purpose) and canonical fingerprint"
      }
    ],
