  "identities": [
    {
      "identity": "callId",
      "owner": "IVR gateway",
      "uniqueness": "globally unique across nodes; 1-128; immutable; one callId per inbound call",
      "precondition": "created on first inbound; every later message requires the existing call",
      "replayConflict": "same callId and fingerprint replays; changed caller/access/node is a stable conflict",
      "a0a1Mapping": "ivr.inbound_session.call_id; ivr.call_record.call_id; resolve path"
    },
    {
      "identity": "sessionId",
      "owner": "backend",
      "uniqueness": "UUID; one per callId; immutable",
      "precondition": "created or reused by resolve",
      "replayConflict": "derived from callId; no client input",
      "a0a1Mapping": "ivr.inbound_session.id"
    },
    {
      "identity": "decisionId",
      "owner": "backend",
      "uniqueness": "UUID; one per (callId,purpose); frozen",
      "precondition": "first decision for the purpose committed",
      "replayConflict": "same fingerprint replays; changed fingerprint is 409 SESSION_IDENTITY_MISMATCH",
      "a0a1Mapping": "ivr.ivr_decision.id; uq_ivr_decision_call_purpose"
    },
    {
      "identity": "decision fingerprint",
      "owner": "backend",
      "uniqueness": "one canonical SHA-256 per decision purpose; immutable",
      "precondition": "computed at decision time",
      "replayConflict": "same fingerprint replays; changed fingerprint is 409 SESSION_IDENTITY_MISMATCH",
      "a0a1Mapping": "ivr.ivr_decision.request_fingerprint; A0 §10.17"
    },
    {
      "identity": "taskId",
      "owner": "backend",
      "uniqueness": "text 1-64; globally unique; immutable after claim",
      "precondition": "PENDING task claimed for a task-backed decision",
      "replayConflict": "same task replays; a different task never replaces a claimed task",
      "a0a1Mapping": "ivr.outbound_call_task.task_id; ivr.call_record.task_id"
    },
    {
      "identity": "reservationId",
      "owner": "backend",
      "uniqueness": "UUID; one per call; terminal once",
      "precondition": "committed with the task claim or direct authorization",
      "replayConflict": "replay never renews and never creates a second reservation",
      "a0a1Mapping": "entitlement_metering.usage_reservation.id; uq_usage_reservation_call"
    },
    {
      "identity": "action / executable intent",
      "owner": "backend",
      "uniqueness": "one per decision; frozen",
      "precondition": "selected only by the backend action selector",
      "replayConflict": "replay returns the same action; the IVR never reselects",
      "a0a1Mapping": "ivr.ivr_decision.action; ck_ivr_decision_action"
    },
    {
      "identity": "eventId",
      "owner": "IVR",
      "uniqueness": "1-128; globally unique in IVR_EVENT; immutable",
      "precondition": "parent call exists",
      "replayConflict": "same eventId and fingerprint returns the first receipt; changed content is EVENT_ID_CONFLICT",
      "a0a1Mapping": "ivr.call_event.event_id; uq_call_event_domain_id"
    },
    {
      "identity": "sequenceNo",
      "owner": "IVR",
      "uniqueness": "positive integer; unique per call when present",
      "precondition": "event creation",
      "replayConflict": "a different event reusing it is a sequence conflict",
      "a0a1Mapping": "ivr.call_event.sequence_no"
    },
    {
      "identity": "legId",
      "owner": "IVR",
      "uniqueness": "1-64; unique per call; immutable",
      "precondition": "leg event or terminal fact",
      "replayConflict": "same leg facts are idempotent; conflicting facts are quarantined",
      "a0a1Mapping": "ivr.call_leg.leg_id"
    },
    {
      "identity": "B-leg operation",
      "owner": "IVR local",
      "uniqueness": "key callId; one per call; durable local operation",
      "precondition": "committed authorization decision and before any line request",
      "replayConflict": "restore only; never create a second B-leg operation",
      "a0a1Mapping": "A0 has no table; Q28 local operation"
    },
    {
      "identity": "recordingId",
      "owner": "IVR",
      "uniqueness": "1-128; globally unique; immutable",
      "precondition": "call known and upload not expired",
      "replayConflict": "same declaration or observed facts replay; changed identity is RECORDING_IDENTITY_CONFLICT",
      "a0a1Mapping": "evidence.recording.recording_id"
    },
    {
      "identity": "upload credential",
      "owner": "backend",
      "uniqueness": "short-lived; single object; not an identity; not return-once",
      "precondition": "declaration succeeded",
      "replayConflict": "may be reissued or replayed but never changes recording or object identity",
      "a0a1Mapping": "A0 upload session; no column"
    },
    {
      "identity": "upload expiry",
      "owner": "backend",
      "uniqueness": "equals recording.upload_expires_at; not renewed",
      "precondition": "declaration created",
      "replayConflict": "replay does not extend it; expiry is UPLOAD_EXPIRED",
      "a0a1Mapping": "evidence.recording.upload_expires_at"
    },
    {
      "identity": "terminal fact",
      "owner": "IVR to backend",
      "uniqueness": "first accepted terminal per call; eventId identity",
      "precondition": "call exists and its state permits the fact",
      "replayConflict": "duplicate returns the first outcome; a conflicting terminal is quarantined",
      "a0a1Mapping": "ivr.call_record.ended_at; ivr.call_record.end_reason; ivr.call_record.authoritative_seconds; ivr.call_event.event_id"
    },
    {
      "identity": "heartbeat",
      "owner": "IVR",
      "uniqueness": "eventId; repeatable; no business state change",
      "precondition": "call known",
      "replayConflict": "same eventId replays; never releases, authorizes or redials",
      "a0a1Mapping": "ivr.call_event.processing_status"
    },
    {
      "identity": "bridge fact",
      "owner": "IVR",
      "uniqueness": "callId plus legIds; no independent backend identity",
      "precondition": "both legs answered or terminal reconciliation",
      "replayConflict": "consistent facts are idempotent; regressing facts are quarantined",
      "a0a1Mapping": "ivr.call_record.bridged_at"
    },
    {
      "identity": "recording start/end",
      "owner": "IVR",
      "uniqueness": "callId plus eventId",
      "precondition": "bridge occurred",
      "replayConflict": "consistent facts are idempotent; contradictory facts are quarantined",
      "a0a1Mapping": "ivr.call_record.recording_started_at; ivr.call_record.recording_ended_at"
    },
    {
      "identity": "media object",
      "owner": "backend",
      "uniqueness": "internal UUID/version/hash; immutable",
      "precondition": "upload observation",
      "replayConflict": "same object/version/hash is reused; a different identity conflicts",
      "a0a1Mapping": "evidence.media_object.id"
    },
    {
      "identity": "evidence record",
      "owner": "backend",
      "uniqueness": "internal UUID; downstream owner",
      "precondition": "recording VALIDATED and evidence owner flow",
      "replayConflict": "A2 defines no evidence wire replay",
      "a0a1Mapping": "evidence.evidence_record.id"
    },
    {
      "identity": "settlement fact",
      "owner": "backend",
      "uniqueness": "unique reservation/type and source event",
      "precondition": "accepted terminal fact",
      "replayConflict": "duplicates return the first fact; conflicts are quarantined",
      "a0a1Mapping": "entitlement_metering.usage_fact.id; uq_usage_fact_reservation_type"
    },
    {
      "identity": "IVR event outbox",
      "owner": "IVR local",
      "uniqueness": "(callId,eventId); immutable payload",
      "precondition": "event generated",
      "replayConflict": "retransmit the same identity; never mint a replacement identity",
      "a0a1Mapping": "Q28 local durable store"
    }
  ],
  "actionSelection": {
    "selector": "select_call_action",
    "contract": "One IvrDecision shape for all three purposes; the IVR executes only the returned action.",
    "purposeOrder": [
      "INBOUND_RESOLVE",
      "ACTIVATION_NEXT_ACTION",
      "DIRECT_AUTHORIZATION"
    ],
    "rules": [
      {
        "result": "DIAL_TASK_CALLEE",
        "requires": [
          "taskMatch is CLAIMED",
          "taskId, businessType and masked callee are present",
          "reservationId, authorizedRecordingSeconds and authorizationExpiresAt are present",
          "the full callee exists only in the encrypted internal task payload"
        ],
        "ivrBehavior": [
          "persist one callId B-leg operation before any line request",
          "dial the frozen task callee",
          "bridge and record after the callee answers",
          "do not require callee confirmation"
        ],
        "forbidden": [
          "calling direct authorization",
          "selecting another callee",
          "recomputing the task"
        ]
      },
      {
        "result": "ENTER_CALLEE",
        "requires": [
          "no task is claimed",
          "taskMatch is NONE",
          "no reservation exists"
        ],
        "ivrBehavior": [
          "collect the direct callee through DTMF",
          "confirm the entered callee",
          "call direct authorization"
        ],
        "forbidden": [
          "claiming a task",
          "treating the DTMF callee as a task callee"
        ]
      },
      {
        "result": "GUIDE_ACTIVATION",
        "requires": [
          "no reservation exists",
          "reasonCode is ACTIVATION_REQUIRED or CONSENT_REQUIRED"
        ],
        "ivrBehavior": [
          "play the versioned activation and consent notice",
          "after explicit key 1 call activation confirmation at most once",
          "execute the returned next action"
        ],
        "forbidden": [
          "activating before key 1",
          "repeating confirmation to obtain a second trial",
          "rewriting the resolve decision"
        ]
      },
      {
        "result": "GUIDE_PURCHASE",
        "requires": [
          "no reservation exists",
          "reasonCode is NO_AVAILABLE_ENTITLEMENT"
        ],
        "ivrBehavior": [
          "play purchase guidance for the Mini Program or Web and then end"
        ],
        "forbidden": [
          "creating an order",
          "taking payment",
          "placing an outbound call"
        ]
      },
      {
        "result": "REJECT",
        "requires": [
          "no reservation exists",
          "a matching rejection reasonCode is present"
        ],
        "ivrBehavior": [
          "play the failure notice and end"
        ],
        "forbidden": [
          "outbound dialing",
          "claiming a task",
          "retrying routing"
        ]
      },
      {
        "result": "REJECT_SUSPENDED",
        "requires": [
          "no reservation exists",
          "reasonCode is ACTIVATION_SUSPENDED"
        ],
        "ivrBehavior": [
          "play the suspension notice and offline service entry, then end"
        ],
        "forbidden": [
          "restoring activation through IVR"
        ]
      },
      {
        "result": "REJECT_CALL_IN_PROGRESS",
        "requires": [
          "no reservation exists",
          "reasonCode is CALL_IN_PROGRESS"
        ],
        "ivrBehavior": [
          "play a retry-later notice and end"
        ],
        "forbidden": [
          "concurrent outbound dialing"
        ]
      }
    ],
    "directSuccess": {
      "purpose": "DIRECT_AUTHORIZATION",
      "action": null,
      "reasonCode": "DIRECT_AUTHORIZED",
      "requires": [
        "taskMatch is NONE",
        "task fields are null",
        "a reservation is committed and HELD",
        "the confirmed callee exists only in the encrypted authorization payload"
      ],
      "ivrBehavior": [
        "persist one callId B-leg operation before any line request",
        "dial the confirmed direct callee"
      ],
      "forbidden": [
        "using task fields",
        "authorizing direct outbound a second time",
        "recollecting the callee"
      ]
    },
    "sharedInvariants": [
      "one decision has exactly one executable intent",
      "direct success is a purpose-specific execution rule, not an eighth action",
      "availableRecordingSeconds is a routing snapshot only",
      "authorizedRecordingSeconds is the only spend ceiling",
      "authorizationExpiresAt is the last instant to start a B-leg and is never renewed by replay",
      "the task path never asks the caller to confirm the callee",
      "the direct path never falls back to a task",
      "one call supports at most one successful confirm and one successful direct authorization"
    ]
  },
